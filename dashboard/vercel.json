{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/Portfolio",
      "destination": "/api"
    },
    {
      "source": "/Portfolio/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{data,event-driven-bot/data,political-copy-bot/data,journal,config}/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/guardian-trigger",
      "schedule": "50 13 * * 1-5"
    },
    {
      "path": "/api/guardian-trigger",
      "schedule": "10 14 * * 1-5"
    },
    {
      "path": "/api/guardian-trigger",
      "schedule": "45 14 * * 1-5"
    },
    {
      "path": "/api/guardian-trigger",
      "schedule": "10 16 * * 1-5"
    },
    {
      "path": "/api/guardian-trigger",
      "schedule": "45 19 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
